</header>

<!-- CONTENIDO -->
<main>
    <div class="contenedor">

        <div class="bloque">
            <img src="img/edición 1.jpg">
            <h2>Micro-ecosistema 1</h2>
            <p>Collages de monotipos editados.</p>
        </div>

        <div class="bloque">
            <img src="img/edición 2.jpg">
            <h2>Micro-ecosistema 2</h2>
            <p>Collages de monotipos editados.</p>
        </div>

        <div class="bloque">
            <img src="img/edición 3.jpg">
            <h2>Micro-ecosistema 3</h2>
            <p>Collages de monotipos editados.</p>
        </div>

    </div>
</main>



<script src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"></script>

<script>

// ESCENA
const scene = new THREE.Scene();
const camera = new THREE.OrthographicCamera(-1,1,1,-1,0,1);

const renderer = new THREE.WebGLRenderer({ antialias:true });
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setClearColor("#7d9768", 1);

// canvas al fondo
document.body.prepend(renderer.domElement);

// SHADER
const material = new THREE.ShaderMaterial({

uniforms:{
time:{value:0},
resolution:{value:new THREE.Vector2(window.innerWidth,window.innerHeight)}
},

transparent:true,

fragmentShader:`

precision highp float;
uniform float time;
uniform vec2 resolution;

float metaball(vec2 p, vec2 c, float r){
float d = length(p-c);
return r*r/(d*d);
}

float noise(vec2 p){
return sin(p.x*3.0)*sin(p.y*3.0);
}

vec2 warp(vec2 uv){
float n = noise(uv*2.0 + time*0.15);
float a = n*3.14;
return uv + vec2(cos(a),sin(a))*0.07;
}

void main(){

vec2 uv = gl_FragCoord.xy / resolution.xy;
uv = uv*2.0-1.0;
uv = warp(uv);

float field=0.0;

for(int i=0;i<6;i++){
float fi=float(i);
vec2 pos=vec2(
sin(time*0.15+fi)*0.5,
cos(time*0.2+fi*1.3)*0.5
);
field+=metaball(uv,pos,0.3);
}

float holes=0.0;

for(int i=0;i<6;i++){
float fi=float(i);
vec2 pos=vec2(
cos(time*0.2+fi)*0.4,
sin(time*0.25+fi)*0.4
);
holes+=metaball(uv,pos,0.25);
}

float value=field-holes*1.2;
float shape=smoothstep(0.4,0.9,value);

vec3 verde=vec3(0.22,0.58,0.3);
vec3 ambar=vec3(1.0,0.65,0.25);

vec3 color=mix(verde,ambar,0.5);

float alpha=shape;

gl_FragColor=vec4(color,alpha);
}
`
});

const mesh = new THREE.Mesh(new THREE.PlaneGeometry(2,2), material);
scene.add(mesh);

// ANIMACIÓN
function animate(){
material.uniforms.time.value+=0.01;
renderer.render(scene,camera);
requestAnimationFrame(animate);
}
animate();

</script>


<script>
const btn = document.getElementById("menuBtn");
const menu = document.getElementById("menu");

btn.addEventListener("click", function(e){
    e.preventDefault();
    menu.classList.toggle("active");
});

document.addEventListener("click", function(e){
    if (!btn.contains(e.target) && !menu.contains(e.target)) {
        menu.classList.remove("active");
    }
});
</script>

</body>
